<Window x:Class="WhoWantsToBeAShillionaire.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Who Wants to Be a Shillionaire?" 
        Height="800" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource PrimaryBackground}"
        Icon="Assets/icon.ico">
    
    <Grid>
        <!-- Main Menu Screen -->
        <Grid x:Name="MainMenuScreen" Visibility="Visible">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f172a" Offset="0"/>
                    <GradientStop Color="#1e293b" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock Text="Who Wants to Be a" 
                          FontSize="48" 
                          FontWeight="Bold" 
                          Foreground="{DynamicResource GoldColor}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,10"/>
                <TextBlock Text="SHILLIONAIRE?" 
                          FontSize="64" 
                          FontWeight="Bold" 
                          Foreground="{DynamicResource GoldColor}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,50"/>
                
                <Button x:Name="StartGameButton" 
                        Content="Start Game" 
                        Style="{DynamicResource GameButtonStyle}"
                        FontSize="24"
                        Padding="40,15"
                        Click="StartGameButton_Click"/>
                
                <Button x:Name="AdminButton" 
                        Content="Admin Panel" 
                        Style="{DynamicResource GameButtonStyle}"
                        Click="AdminButton_Click"/>
                
                <Button x:Name="SettingsButton" 
                        Content="Settings" 
                        Style="{DynamicResource GameButtonStyle}"
                        Click="SettingsButton_Click"/>
                
                <Button x:Name="ExitButton" 
                        Content="Exit" 
                        Style="{DynamicResource GameButtonStyle}"
                        Click="ExitButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Game Screen -->
        <Grid x:Name="GameScreen" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f172a" Offset="0"/>
                    <GradientStop Color="#1e293b" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Game Header -->
            <Grid Grid.Row="0" Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="QuestionCounterText" 
                          Grid.Column="0"
                          Text="Question 1 of 15" 
                          FontSize="18" 
                          Foreground="White"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"/>

                <TextBlock x:Name="PrizeMoneyText" 
                          Grid.Column="2"
                          Text="$0" 
                          FontSize="24" 
                          FontWeight="Bold"
                          Foreground="{DynamicResource GoldColor}"
                          HorizontalAlignment="Right"
                          VerticalAlignment="Center"/>
            </Grid>

            <!-- Game Content -->
            <Grid Grid.Row="1" Margin="40,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Question -->
                <Border Grid.Row="0" 
                        Background="{DynamicResource SecondaryBackground}" 
                        CornerRadius="10" 
                        Padding="30" 
                        Margin="0,0,0,30">
                    <TextBlock x:Name="QuestionText" 
                              Text="Loading question..." 
                              FontSize="22" 
                              Foreground="White"
                              TextWrapping="Wrap"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"/>
                </Border>

                <!-- Answers -->
                <Grid Grid.Row="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Button x:Name="AnswerA" 
                            Grid.Row="0" Grid.Column="0"
                            Style="{DynamicResource AnswerButtonStyle}"
                            Click="AnswerButton_Click"
                            Tag="A">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="A: " FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBlock x:Name="AnswerAText" Text="Answer A" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AnswerB" 
                            Grid.Row="0" Grid.Column="1"
                            Style="{DynamicResource AnswerButtonStyle}"
                            Click="AnswerButton_Click"
                            Tag="B">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="B: " FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBlock x:Name="AnswerBText" Text="Answer B" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AnswerC" 
                            Grid.Row="1" Grid.Column="0"
                            Style="{DynamicResource AnswerButtonStyle}"
                            Click="AnswerButton_Click"
                            Tag="C">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="C: " FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBlock x:Name="AnswerCText" Text="Answer C" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="AnswerD" 
                            Grid.Row="1" Grid.Column="1"
                            Style="{DynamicResource AnswerButtonStyle}"
                            Click="AnswerButton_Click"
                            Tag="D">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="D: " FontWeight="Bold" Margin="0,0,10,0"/>
                            <TextBlock x:Name="AnswerDText" Text="Answer D" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Lifelines -->
                <StackPanel Grid.Row="2" 
                           Orientation="Horizontal" 
                           HorizontalAlignment="Center" 
                           Margin="0,30,0,0">
                    <Button x:Name="FiftyFiftyButton" 
                            Content="50:50" 
                            Style="{DynamicResource LifelineButtonStyle}"
                            Click="FiftyFiftyButton_Click"/>
                    <Button x:Name="PhoneFriendButton" 
                            Content="📞 Friend" 
                            Style="{DynamicResource LifelineButtonStyle}"
                            Click="PhoneFriendButton_Click"/>
                    <Button x:Name="AskAudienceButton" 
                            Content="👥 Audience" 
                            Style="{DynamicResource LifelineButtonStyle}"
                            Click="AskAudienceButton_Click"/>
                </StackPanel>
            </Grid>

            <!-- Game Controls -->
            <Grid Grid.Row="2" Margin="40,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="FinalAnswerButton" 
                        Grid.Column="1"
                        Content="Final Answer" 
                        Style="{DynamicResource GameButtonStyle}"
                        IsEnabled="False"
                        Click="FinalAnswerButton_Click"/>

                <Button x:Name="WalkAwayButton" 
                        Grid.Column="2"
                        Content="Walk Away" 
                        Style="{DynamicResource GameButtonStyle}"
                        Background="#dc2626"
                        Click="WalkAwayButton_Click"/>
            </Grid>
        </Grid>

        <!-- Admin Screen -->
        <Grid x:Name="AdminScreen" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f172a" Offset="0"/>
                    <GradientStop Color="#1e293b" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" 
                      Text="Admin Panel" 
                      FontSize="32" 
                      FontWeight="Bold" 
                      Foreground="{DynamicResource GoldColor}"
                      HorizontalAlignment="Center"
                      Margin="0,20"/>

            <TabControl Grid.Row="1" Margin="20" Background="Transparent">
                <TabItem Header="Questions" Foreground="White">
                    <Grid Margin="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Question Form -->
                        <StackPanel Grid.Column="0" Margin="0,0,20,0">
                            <TextBlock Text="Add/Edit Question" 
                                      FontSize="18" 
                                      FontWeight="Bold" 
                                      Foreground="White" 
                                      Margin="0,0,0,20"/>

                            <TextBlock Text="Difficulty:" Foreground="White" Margin="0,0,0,5"/>
                            <ComboBox x:Name="DifficultyComboBox" Margin="0,0,0,15">
                                <ComboBoxItem Content="Easy (1-5)" Tag="1"/>
                                <ComboBoxItem Content="Medium (6-10)" Tag="2"/>
                                <ComboBoxItem Content="Hard (11-15)" Tag="3"/>
                            </ComboBox>

                            <TextBlock Text="Question:" Foreground="White" Margin="0,0,0,5"/>
                            <TextBox x:Name="QuestionTextBox" 
                                    Height="80" 
                                    TextWrapping="Wrap" 
                                    AcceptsReturn="True"
                                    Margin="0,0,0,15"/>

                            <TextBlock Text="Answer A:" Foreground="White" Margin="0,0,0,5"/>
                            <TextBox x:Name="AnswerATextBox" Margin="0,0,0,10"/>

                            <TextBlock Text="Answer B:" Foreground="White" Margin="0,0,0,5"/>
                            <TextBox x:Name="AnswerBTextBox" Margin="0,0,0,10"/>

                            <TextBlock Text="Answer C:" Foreground="White" Margin="0,0,0,5"/>
                            <TextBox x:Name="AnswerCTextBox" Margin="0,0,0,10"/>

                            <TextBlock Text="Answer D:" Foreground="White" Margin="0,0,0,5"/>
                            <TextBox x:Name="AnswerDTextBox" Margin="0,0,0,15"/>

                            <TextBlock Text="Correct Answer:" Foreground="White" Margin="0,0,0,5"/>
                            <ComboBox x:Name="CorrectAnswerComboBox" Margin="0,0,0,20">
                                <ComboBoxItem Content="A" Tag="A"/>
                                <ComboBoxItem Content="B" Tag="B"/>
                                <ComboBoxItem Content="C" Tag="C"/>
                                <ComboBoxItem Content="D" Tag="D"/>
                            </ComboBox>

                            <!-- AI Generation Options -->
                            <TextBlock Text="AI Generation Options" Foreground="White" FontWeight="Bold" Margin="0,10,0,10"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                <TextBlock Text="Difficulty:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <RadioButton x:Name="EasyRadio" Content="Easy" Foreground="White" IsChecked="True" Margin="0,0,10,0"/>
                                <RadioButton x:Name="MediumRadio" Content="Medium" Foreground="White" Margin="0,0,10,0"/>
                                <RadioButton x:Name="HardRadio" Content="Hard" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,20">
                                <TextBlock Text="Category:" Foreground="White" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <TextBox x:Name="CategoryTextBox" Width="250"/>
                            </StackPanel>

                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="GenerateQuestionsButton" 
                                       Content="Generate AI Questions" 
                                       Style="{DynamicResource GameButtonStyle}"
                                       Click="GenerateQuestionsButton_Click"/>
                                <Button x:Name="SaveQuestionButton" 
                                       Content="Save Question" 
                                       Style="{DynamicResource GameButtonStyle}"
                                       Click="SaveQuestionButton_Click"/>
                                <Button x:Name="ClearFormButton" 
                                       Content="Clear Form" 
                                       Style="{DynamicResource GameButtonStyle}"
                                       Background="#6b7280"
                                       Click="ClearFormButton_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Questions List -->
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Existing Questions" 
                                      FontSize="18" 
                                      FontWeight="Bold" 
                                      Foreground="White" 
                                      Margin="0,0,0,20"/>
                            
                            <ScrollViewer Height="500">
                                <ListBox x:Name="QuestionsListBox" 
                                        Background="Transparent"
                                        Foreground="White"
                                        SelectionChanged="QuestionsListBox_SelectionChanged"/>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Import/Export" Foreground="White">
                    <StackPanel Margin="20">
                        <TextBlock Text="Import/Export Questions" 
                                  FontSize="18" 
                                  FontWeight="Bold" 
                                  Foreground="White" 
                                  Margin="0,0,0,30"/>

                        <Button x:Name="ImportQuestionsButton" 
                               Content="Import Questions from JSON" 
                               Style="{DynamicResource GameButtonStyle}"
                               Click="ImportQuestionsButton_Click"/>

                        <Button x:Name="ExportQuestionsButton" 
                               Content="Export Questions to JSON" 
                               Style="{DynamicResource GameButtonStyle}"
                               Click="ExportQuestionsButton_Click"/>
                    </StackPanel>
                </TabItem>
            </TabControl>

            <Button Grid.Row="2" 
                   x:Name="BackToMenuButton" 
                   Content="Back to Main Menu" 
                   Style="{DynamicResource GameButtonStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,20"
                   Click="BackToMenuButton_Click"/>
        </Grid>

        <!-- Game Over Screen -->
        <Grid x:Name="GameOverScreen" Visibility="Collapsed">
            <Grid.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#0f172a" Offset="0"/>
                    <GradientStop Color="#1e293b" Offset="1"/>
                </LinearGradientBrush>
            </Grid.Background>
            
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <TextBlock x:Name="GameOverTitle" 
                          Text="Game Over!" 
                          FontSize="48" 
                          FontWeight="Bold" 
                          Foreground="{DynamicResource GoldColor}"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,30"/>

                <TextBlock x:Name="FinalPrizeText" 
                          Text="You won: $0" 
                          FontSize="32" 
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,20"/>

                <TextBlock x:Name="QuestionsAnsweredText" 
                          Text="Questions answered: 0" 
                          FontSize="18" 
                          Foreground="White"
                          HorizontalAlignment="Center"
                          Margin="0,0,0,40"/>

                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayAgainButton" 
                           Content="Play Again" 
                           Style="{DynamicResource GameButtonStyle}"
                           Click="PlayAgainButton_Click"/>
                    
                    <Button x:Name="MainMenuButton" 
                           Content="Main Menu" 
                           Style="{DynamicResource GameButtonStyle}"
                           Click="MainMenuButton_Click"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Grid>
</Window>