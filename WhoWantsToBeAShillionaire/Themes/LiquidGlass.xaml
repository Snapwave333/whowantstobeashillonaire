<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!-- Apple-style Liquid Glass Theme -->
  <!-- Brushes: brighter, translucent surfaces, vibrant iOS blue accents -->
  <LinearGradientBrush x:Key="PrimaryBackground" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F5F9FF" Offset="0"/>
    <GradientStop Color="#E9F0FA" Offset="1"/>
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="SecondaryBackground" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFFFFFF" Offset="0"/>
    <GradientStop Color="#F6FAFF" Offset="1"/>
  </LinearGradientBrush>

  <SolidColorBrush x:Key="AccentColor" Color="#0A84FF"/>
  <SolidColorBrush x:Key="TextColor" Color="#111111"/>
  <SolidColorBrush x:Key="GoldColor" Color="#FFD60A"/>

  <!-- Default GroupBox style: subtle glass card -->
  <Style TargetType="GroupBox">
    <Setter Property="Padding" Value="8"/>
    <Setter Property="Margin" Value="0,0,0,20"/>
    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
    <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="GroupBox">
          <Grid>
            <Border CornerRadius="12"
                    Background="{StaticResource SecondaryBackground}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <Border Background="{StaticResource SecondaryBackground}"
                        CornerRadius="10,10,0,0"
                        Padding="6"
                        BorderThickness="0">
                  <ContentPresenter Content="{TemplateBinding Header}"/>
                </Border>
                <ContentPresenter Grid.Row="1" Margin="8"/>
              </Grid>
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Glass button styles -->
  <Style x:Key="GameButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
    <Setter Property="FontSize" Value="16"/>
    <Setter Property="FontWeight" Value="Bold"/>
    <Setter Property="Padding" Value="20,10"/>
    <Setter Property="Margin" Value="10"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#80FFFFFF" Offset="0"/>
          <GradientStop Color="#66FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="14"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#99FFFFFF" Offset="0"/>
                    <GradientStop Color="#80FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Background">
                <Setter.Value>
                  <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#80FFFFFF" Offset="0"/>
                    <GradientStop Color="#66FFFFFF" Offset="1"/>
                  </LinearGradientBrush>
                </Setter.Value>
              </Setter>
              <Setter Property="BorderBrush" Value="#0058D0"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="AnswerButtonStyle" TargetType="Button">
    <Setter Property="Foreground" Value="{StaticResource TextColor}"/>
    <Setter Property="FontSize" Value="14"/>
    <Setter Property="Padding" Value="15,10"/>
    <Setter Property="Margin" Value="5"/>
    <Setter Property="BorderThickness" Value="1"/>
    <Setter Property="BorderBrush" Value="#22000000"/>
    <Setter Property="HorizontalContentAlignment" Value="Left"/>
    <Setter Property="Cursor" Value="Hand"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#80FFFFFF" Offset="0"/>
          <GradientStop Color="#66FFFFFF" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="12"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  BorderBrush="{TemplateBinding BorderBrush}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalAlignment="Center"/>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="{StaticResource AccentColor}"/>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter Property="Opacity" Value="0.9"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.6"/>
              <Setter Property="Cursor" Value="Arrow"/>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="CorrectAnswerStyle" TargetType="Button" BasedOn="{StaticResource AnswerButtonStyle}">
    <Setter Property="BorderBrush" Value="#34C759"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#80EAFBEA" Offset="0"/>
          <GradientStop Color="#66EAFBEA" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="WrongAnswerStyle" TargetType="Button" BasedOn="{StaticResource AnswerButtonStyle}">
    <Setter Property="BorderBrush" Value="#FF3B30"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#80FFEAEA" Offset="0"/>
          <GradientStop Color="#66FFEAEA" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="SelectedAnswerStyle" TargetType="Button" BasedOn="{StaticResource AnswerButtonStyle}">
    <Setter Property="BorderBrush" Value="#FF9F0A"/>
    <Setter Property="Background">
      <Setter.Value>
        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
          <GradientStop Color="#80FFF5E5" Offset="0"/>
          <GradientStop Color="#66FFF5E5" Offset="1"/>
        </LinearGradientBrush>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>