{
  "appId": "com.shillionaire.desktop",
  "productName": "Who Wants to be a Shillionaire",
  "directories": {
    "output": "dist"
  },
  "icon": "assets/icon.png",
  "files": [
    "src/**/*",
    "build/**/*",
    "node_modules/**/*"
  ],
  "extraResources": [],
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      },
      {
        "target": "portable",
        "arch": ["x64"]
      }
    ],
    "requestedExecutionLevel": "asInvoker",
    "artifactName": "${productName}-${version}-${arch}.${ext}"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Who Wants to be a Shillionaire"
  },
  "portable": {
    "artifactName": "${productName}-Portable-${version}-${arch}.${ext}"
  },
  "compression": "normal"
}