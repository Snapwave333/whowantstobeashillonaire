{
  "name": "who-wants-to-be-a-shillionaire",
  "version": "1.0.0",
  "description": "Who Wants to Be a Shillionaire - Desktop Trivia Game",
  "main": "src/main.js",
  "homepage": "./",
  "author": "Snapwave333",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron-forge start",
    "dev": "concurrently \"npm run dev:react\" \"wait-on http://localhost:3000 && electron src/main.js\"",
    "dev:react": "cd ../frontend && npm start",
    "build:react": "cd ../frontend && npm run build && node -e \"const fs=require('fs'); const path=require('path'); function copyDir(src,dest){if(!fs.existsSync(dest))fs.mkdirSync(dest,{recursive:true}); const entries=fs.readdirSync(src,{withFileTypes:true}); for(let entry of entries){const srcPath=path.join(src,entry.name); const destPath=path.join(dest,entry.name); if(entry.isDirectory()){copyDir(srcPath,destPath);}else{fs.copyFileSync(srcPath,destPath);}}} copyDir('build','../desktop-app/build');\"",
    "build": "electron-packager . who-wants-to-be-a-shillionaire --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"node_modules/(electron-prebuilt|electron-packager)\" --ignore=\"\\.git\"",
    "build:win": "electron-packager . who-wants-to-be-a-shillionaire --platform=win32 --arch=x64 --out=dist --overwrite --ignore=\"node_modules/(electron-prebuilt|electron-packager)\" --ignore=\"\\.git\"",
    "build:mac": "electron-packager . who-wants-to-be-a-shillionaire --platform=darwin --arch=x64 --out=dist --overwrite --ignore=\"node_modules/(electron-prebuilt|electron-packager)\" --ignore=\"\\.git\"",
    "build:linux": "electron-packager . who-wants-to-be-a-shillionaire --platform=linux --arch=x64 --out=dist --overwrite --ignore=\"node_modules/(electron-prebuilt|electron-packager)\" --ignore=\"\\.git\"",
    "build:exe": "electron-builder --win --x64",
    "build:portable": "electron-builder --win portable --x64",
    "build:installer": "electron-builder --win nsis --x64",
    "pack": "npm run build:react && npm run build",
    "test": "jest",
    "postinstall": "electron-builder install-app-deps",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "build": {
    "appId": "com.snapwave.shillionaire",
    "productName": "Who Wants to be a Shillionaire",
    "directories": {
      "output": "dist",
      "buildResources": "assets"
    },
    "files": [
      "src/**/*",
      "build/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/",
        "to": "assets/",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.png",
      "requestedExecutionLevel": "asInvoker",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Who Wants to be a Shillionaire"
    },
    "publish": {
      "provider": "github",
      "owner": "Snapwave333",
      "repo": "whowantstobeashillonaire"
    }
  },
  "dependencies": {
    "@genwave/svgmaker-mcp": "^0.3.0",
    "axios": "^1.6.2",
    "electron-log": "^5.0.1",
    "electron-squirrel-startup": "^1.0.1",
    "electron-store": "^8.1.0",
    "electron-updater": "^6.1.7",
    "smart-buffer": "^4.2.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.10.0",
    "@electron-forge/maker-deb": "^7.10.0",
    "@electron-forge/maker-rpm": "^7.10.0",
    "@electron-forge/maker-squirrel": "^7.10.0",
    "@electron-forge/maker-zip": "^7.10.0",
    "@electron-forge/plugin-auto-unpack-natives": "^7.10.0",
    "@electron-forge/plugin-fuses": "^7.10.0",
    "@electron/fuses": "^1.8.0",
    "electron": "^38.3.0",
    "electron-packager": "^17.1.2",
    "electron-builder": "^24.9.1"
  }
}
